<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- GLES 2.0 is the floor librw's GLES arm falls back to; 3.1 is what it
         asks for first. Declared as 2.0 so a device that can only do that is
         not filtered out of the store listing before the fallback is even
         tried. -->
    <uses-feature android:glEsVersion="0x00020000" />

    <!-- None of these are required, and that is the point of listing them: a
         device without a gamepad still installs, and a device WITH one gets
         the game working through SDL with nothing written for it. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- The rumble the game already asks for, through xPadRumbleEnable. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No storage permission, deliberately. The assets live in this
         application's own directory under Android/data, which needs no
         permission from this side and is reachable over USB and from a file
         manager on the other. See docs/ANDROID.md, "Assets". -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:isGame="true">

        <!-- configChanges below lists every configuration change the
             activity handles itself rather than being destroyed and recreated
             for. That is not a nicety: an activity restart destroys the EGL
             context, and librw has no path that rebuilds its rasters and
             shaders, so a rotation or a keyboard appearing would take the
             renderer out from under the game. See docs/ANDROID.md, "Losing
             the GL context". -->
        <activity
            android:name=".BfbbActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- So a controller plugged in over USB reaches this activity. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>

</manifest>
